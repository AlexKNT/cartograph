# The model the agent reasons with: any `provider:model` string `initChatModel`
# understands.
CARTOGRAPH_AGENT_MODEL=openai:gpt-4.1-mini-2025-04-14
OPENAI_API_KEY=

# Where the six tools read the analysis from. The Next app serves this route;
# it is the agent's only way to see anything about a repository.
CARTOGRAPH_TOOLS_URL=http://127.0.0.1:3000/api/agent/tools

# Traces the agent's runs into LangSmith, in the same project the app traces to.
# Leave LANGSMITH_PROJECT unset unless the app sets it too, so that one project
# holds both sides and `npm run evals agent` can read them together.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
